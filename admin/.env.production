# ===== 生产环境配置（打包前按实际部署修改） =====
# 后端 API 地址：默认同源相对路径 /api，由 Nginx 反向代理到后端 8083（Docker 部署形态）
# 若前后端分开部署（不经 Nginx），改为后端实际可访问地址，例如 http://192.168.1.100:8083/api
VUE_APP_BASE_API=/api

# 游客端部署地址：仅用于管理端登录页"游客入口"链接跳转
VUE_APP_OTHER_APP_URL=http://localhost:8080

# WebSocket 地址（可选）：默认自动取当前站点同源 /ws/flow；仅在特殊场景下覆盖
# VUE_APP_WS_URL=ws://your-domain.com/ws/flow