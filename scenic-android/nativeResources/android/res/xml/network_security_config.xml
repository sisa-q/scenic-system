<?xml version="1.0" encoding="utf-8"?>
<!-- 允许 http 明文访问（局域网演示 http://192.168.8.80 必需）；正式上线改用 https 后可移除 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>